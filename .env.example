# Lokale Test-Umgebungsvariablen. Kopieren nach ".env" und Werte eintragen.
# ".env" ist in .gitignore und wird NIE committed.
# In GitHub Actions kommen dieselben Werte aus GitHub Secrets (Settings ->
# Secrets and variables -> Actions), nicht aus dieser Datei.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
