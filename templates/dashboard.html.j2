<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Job-Watcher Dashboard</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #0f1115;
    --card: #1a1d24;
    --border: #2a2e37;
    --text: #e6e8eb;
    --muted: #9aa1ac;
    --accent: #4f8cff;
    --new: #3ecf8e;
    --interesting: #a78bfa;
    --applied: #f5b942;
    --rejected: #6b7280;
    --gone: #e2555c;
  }
  @media (prefers-color-scheme: light) {
    :root {
      --bg: #f6f7f9; --card: #ffffff; --border: #e3e5e9;
      --text: #1b1f27; --muted: #5c6270;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 2rem 1rem 4rem;
    background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .wrap { max-width: 900px; margin: 0 auto; }
  h1 { font-size: 1.5rem; margin-bottom: 0.25rem; }
  .meta { color: var(--muted); font-size: 0.85rem; margin-bottom: 1.5rem; }
  .stats { display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .stat {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 10px; padding: 0.75rem 1.1rem; min-width: 120px;
  }
  .stat .n { font-size: 1.4rem; font-weight: 600; }
  .stat .l { font-size: 0.78rem; color: var(--muted); }
  .warning {
    background: #3a2a12; border: 1px solid #6b4a1a; color: #f3c98b;
    border-radius: 10px; padding: 0.9rem 1.1rem; margin-bottom: 1.5rem; font-size: 0.88rem;
  }
  section { margin-bottom: 2.5rem; }
  h2 {
    font-size: 1.1rem; border-bottom: 1px solid var(--border);
    padding-bottom: 0.4rem; margin-bottom: 1rem;
  }

  /* Sync-Leiste */
  .sync-bar {
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    padding: 0.7rem 1rem; margin-bottom: 1.5rem; font-size: 0.82rem; color: var(--muted);
    display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;
  }
  .sync-bar input[type="password"] {
    flex: 1; min-width: 180px; background: var(--bg); border: 1px solid var(--border);
    border-radius: 6px; padding: 0.35rem 0.6rem; color: var(--text); font-size: 0.82rem;
  }
  .sync-bar button {
    background: var(--accent); color: #fff; border: none; border-radius: 6px;
    padding: 0.35rem 0.8rem; font-size: 0.8rem; cursor: pointer;
  }
  .sync-bar button.secondary { background: transparent; color: var(--muted); border: 1px solid var(--border); }
  .sync-status { font-size: 0.78rem; }
  .sync-status.ok { color: var(--new); }
  .sync-status.err { color: var(--gone); }

  /* Firmen-Sektionen (einklappbar) */
  details.company {
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    margin-bottom: 0.9rem; overflow: hidden;
  }
  details.company summary {
    cursor: pointer; list-style: none; padding: 0.85rem 1.1rem;
    font-size: 0.98rem; font-weight: 600; color: var(--accent);
    display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
  }
  details.company summary::-webkit-details-marker { display: none; }
  details.company summary::before {
    content: "▸"; display: inline-block; margin-right: 0.5rem; color: var(--muted);
    transition: transform 0.15s ease;
  }
  details.company[open] summary::before { transform: rotate(90deg); }
  details.company summary .company-name {
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; flex: 1 1 auto;
  }
  details.company summary .count {
    color: var(--muted); font-weight: 400; font-size: 0.8rem; flex-shrink: 0; white-space: nowrap;
  }
  .company-jobs { padding: 0 1rem 1rem; }

  .hidden-toggle { display: none; margin-bottom: 0.6rem; }
  .hidden-toggle button {
    background: transparent; border: 1px dashed var(--border); color: var(--muted);
    border-radius: 6px; padding: 0.4rem 0.7rem; font-size: 0.78rem; cursor: pointer; width: 100%;
  }
  .hidden-toggle button:hover { border-color: var(--muted); }

  .job {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 0.5rem;
  }
  .job-main {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;
  }
  .job .info { min-width: 0; flex: 1; }
  .job .info a, .job .info a:visited {
    color: var(--text); text-decoration: none; font-weight: 500;
  }
  .job .info a:hover { color: var(--accent); }
  .job .sub { color: var(--muted); font-size: 0.8rem; margin-top: 0.2rem; }
  .badge {
    font-size: 0.72rem; padding: 0.2rem 0.6rem; border-radius: 999px;
    white-space: nowrap; font-weight: 600; flex-shrink: 0;
  }
  .badge.neu { background: color-mix(in srgb, var(--new) 20%, transparent); color: var(--new); }
  .badge.interessant { background: color-mix(in srgb, var(--interesting) 22%, transparent); color: var(--interesting); }
  .badge.beworben { background: color-mix(in srgb, var(--applied) 20%, transparent); color: var(--applied); }
  .badge.kein_interesse { background: color-mix(in srgb, var(--rejected) 25%, transparent); color: var(--rejected); }
  .job.gone { opacity: 0.75; }
  .app-state { font-size: 0.7rem; font-weight: 600; margin-right: 0.3rem; }
  .app-state.online { color: var(--new); }
  .app-state.offline { color: var(--gone); }
  .app-company { color: var(--accent); font-weight: 600; }
  .stale-flag { color: #f3c98b; font-weight: 400; font-size: 0.75rem; flex-shrink: 0; white-space: nowrap; }
  .save-indicator.local { color: #f3c98b; }
  .empty { color: var(--muted); font-size: 0.9rem; font-style: italic; }

  .status-buttons { display: flex; gap: 0.35rem; margin-top: 0.6rem; flex-wrap: wrap; align-items: center; }
  .status-buttons button {
    background: var(--card); border: 1px solid var(--border); color: var(--muted);
    border-radius: 999px; padding: 0.25rem 0.65rem; font-size: 0.72rem; cursor: pointer;
    transition: all 0.1s ease;
  }
  .status-buttons button:hover { border-color: var(--accent); color: var(--text); }
  .status-buttons button.active[data-status-value="neu"] { background: var(--new); border-color: var(--new); color: #0b1f16; }
  .status-buttons button.active[data-status-value="interessant"] { background: var(--interesting); border-color: var(--interesting); color: #1c1533; }
  .status-buttons button.active[data-status-value="beworben"] { background: var(--applied); border-color: var(--applied); color: #2e2205; }
  .status-buttons button.active[data-status-value="kein interesse"] { background: var(--rejected); border-color: var(--rejected); color: #fff; }
  .save-indicator { font-size: 0.72rem; color: var(--muted); min-width: 1.2em; }
  .save-indicator.ok { color: var(--new); }
  .save-indicator.err { color: var(--gone); }

  /* Suche/Filter */
  .search-bar {
    position: sticky; top: 0; z-index: 10;
    background: var(--bg); padding: 0.6rem 0 0.8rem; margin-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
  }
  .search-row { display: flex; gap: 0.5rem; align-items: center; }
  .search-row input[type="search"] {
    flex: 1; min-width: 0; background: var(--card); border: 1px solid var(--border);
    border-radius: 8px; padding: 0.6rem 0.8rem; color: var(--text); font-size: 0.95rem;
  }
  .search-row input[type="search"]:focus { outline: none; border-color: var(--accent); }
  .search-row button {
    background: transparent; color: var(--muted); border: 1px solid var(--border);
    border-radius: 8px; padding: 0.55rem 0.8rem; font-size: 0.8rem; cursor: pointer; white-space: nowrap;
  }
  .search-row button:hover { color: var(--text); border-color: var(--muted); }
  .filter-chips { display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.55rem; align-items: center; }
  .filter-chips button {
    background: var(--card); border: 1px solid var(--border); color: var(--muted);
    border-radius: 999px; padding: 0.25rem 0.7rem; font-size: 0.75rem; cursor: pointer;
  }
  .filter-chips button:hover { border-color: var(--accent); color: var(--text); }
  .filter-chips button.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .filter-chips .chip-label { font-size: 0.75rem; color: var(--muted); margin-right: 0.1rem; }
  .filter-chips .chip-count { opacity: 0.7; }
  .country-pill {
    display: inline-block; font-size: 0.68rem; font-weight: 600; padding: 0.05rem 0.45rem;
    border-radius: 999px; border: 1px solid var(--border); margin-right: 0.3rem; vertical-align: 1px;
  }
  .country-pill.cp-ch { color: #ff8a93; border-color: color-mix(in srgb, #ff8a93 45%, transparent); background: color-mix(in srgb, #ff8a93 12%, transparent); }
  .country-pill.cp-de { color: #e8c25a; border-color: color-mix(in srgb, #e8c25a 45%, transparent); background: color-mix(in srgb, #e8c25a 12%, transparent); }
  .country-pill.cp-li { color: #7fb2ff; border-color: color-mix(in srgb, #7fb2ff 45%, transparent); background: color-mix(in srgb, #7fb2ff 12%, transparent); }
  .search-result { font-size: 0.78rem; color: var(--muted); margin-left: auto; }
  .job.search-miss, details.company.search-empty { display: none !important; }
  .job.search-force { display: block !important; }
  body.searching .hidden-toggle { display: none !important; }
  .match-count { color: var(--accent); font-weight: 400; font-size: 0.8rem; flex-shrink: 0; }
  mark { background: color-mix(in srgb, var(--accent) 35%, transparent); color: inherit; border-radius: 3px; padding: 0 1px; }

  .howto {
    font-size: 0.8rem; color: var(--muted); background: var(--card);
    border: 1px solid var(--border); border-radius: 10px; padding: 0.9rem 1.1rem;
  }
  .howto code {
    background: var(--bg); padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.78rem;
  }
</style>
</head>
<body>
<div class="wrap">
  <h1>🔍 Job-Watcher Dashboard</h1>
  <div class="meta">Letzter Lauf: {{ last_run }}</div>

  <div class="stats">
    <div class="stat"><div class="n">{{ total_open }}</div><div class="l">offene Stellen</div></div>
    <div class="stat"><div class="n">{{ company_count }}</div><div class="l">Firmen überwacht</div></div>
    <div class="stat"><div class="n">{{ new_since_last_run }}</div><div class="l">neu seit letztem Lauf</div></div>
  </div>

  {% if errors %}
  <div class="warning">
    ⚠️ <strong>{{ errors|length }} Firma/Firmen konnten in diesem Lauf nicht gescraped werden:</strong>
    {{ errors.keys()|join(', ') }}
  </div>
  {% endif %}

  <div class="sync-bar" id="sync-bar" data-repo="{{ sync_repo or '' }}" data-branch="{{ sync_branch }}">
    {% if sync_repo %}
      <span>🔄 Geräteübergreifende Synchronisation:</span>
      <input type="password" id="sync-token-input" placeholder="GitHub-Token (Contents: read/write)" autocomplete="off">
      <button id="sync-token-save">Speichern</button>
      <button id="sync-token-clear" class="secondary" style="display:none">Token entfernen</button>
      <span class="sync-status" id="sync-status"></span>
      <span class="sync-status" id="sync-live"></span>
    {% else %}
      <span>Sync nicht aktiv (kein Repo bekannt - läuft dieser Build außerhalb von GitHub Actions?). Statusänderungen bleiben nur lokal im Browser gespeichert.</span>
    {% endif %}
  </div>

  <div class="search-bar">
    <div class="search-row">
      <input type="search" id="job-search" placeholder="Suchen: Titel, Firma, Ort … (z.B. „systems engineer münchen“)" autocomplete="off">
      <button id="job-search-clear" type="button">Zurücksetzen</button>
    </div>
    <div class="filter-chips" id="status-filter">
      <button type="button" data-filter="alle" class="active">Alle</button>
      <button type="button" data-filter="neu">Neu</button>
      <button type="button" data-filter="interessant">Interessant</button>
      <button type="button" data-filter="beworben">Beworben</button>
      <button type="button" data-filter="kein interesse">Kein Interesse</button>
      <span class="search-result" id="search-result"></span>
    </div>
    {% if country_filters %}
    <div class="filter-chips" id="country-filter">
      <span class="chip-label">Land:</span>
      <button type="button" data-country="alle" class="active">Alle</button>
      {% for code, label in country_filters %}
      <button type="button" data-country="{{ code }}">{{ label }} <span class="chip-count"></span></button>
      {% endfor %}
    </div>
    {% endif %}
  </div>

  {% if applications %}
  <section>
    <h2>Meine Bewerbungen</h2>
    <details class="company applications" open>
      <summary>
        <span class="company-name">Bewerbungen</span>
        <span class="match-count"></span>
        <span class="count" data-total="{{ applications|length }}">({{ applications|length }})</span>
      </summary>
      <div class="company-jobs">
        {% for job in applications %}
        <div class="job application{% if job.disappeared_at %} gone{% endif %}" data-job-id="{{ job.id }}" data-company="{{ job.company }}" data-status="{{ job.status or 'neu' }}" data-status-ts="{{ job.status_changed_at or '' }}" data-countries="{{ job.countries_attr }}">
          <div class="job-main">
            <div class="info">
              <a href="{{ job.link }}" target="_blank" rel="noopener">{{ job.title }}</a>
              <div class="sub">
                {% if job.disappeared_at %}<span class="app-state offline">Ausschreibung offline seit {{ job.disappeared_at }}</span>{% else %}<span class="app-state online">Ausschreibung online</span>{% endif %}
                <span class="app-company">{{ job.company }}</span>
                {% if job.location %} · {{ job.location }}{% endif %}
                {% if job.status_date %} · beworben am {{ job.status_date }}{% else %} · gesehen seit {{ job.first_seen }}{% endif %}
              </div>
            </div>
            <span class="badge {{ job.status_class }}">{{ job.status }}</span>
          </div>
          <div class="status-buttons">
            <button data-status-value="neu">Neu</button>
            <button data-status-value="interessant">Interessant</button>
            <button data-status-value="beworben">Beworben</button>
            <button data-status-value="kein interesse">Kein Interesse</button>
            <span class="save-indicator"></span>
          </div>
        </div>
        {% endfor %}
      </div>
    </details>
  </section>
  {% endif %}

  <section>
    <h2>Offene Stellen</h2>
    {% if companies_open %}
      {% for company, jobs in companies_open.items() %}
      <details class="company">
        <summary>
          <span class="company-name">{{ company }}</span>
          <span class="match-count"></span>
          {% if company in company_stale %}<span class="stale-flag" title="Scraper schlägt für diese Firma gerade fehl - Stellen evtl. nicht mehr aktuell">⚠ Stand {{ company_stale[company] }}</span>{% endif %}
          <span class="count" data-total="{{ jobs|length }}">({{ jobs|length }})</span>
        </summary>
        <div class="company-jobs">
          <div class="hidden-toggle">
            <button class="show-hidden-btn" data-expanded="false">🙈 <span class="hidden-count">0</span> ausgeblendet (kein Interesse) - anzeigen</button>
          </div>
          {% for job in jobs %}
          <div class="job" data-job-id="{{ job.id }}" data-company="{{ job.company }}" data-status="{{ job.status or 'neu' }}" data-status-ts="{{ job.status_changed_at or '' }}" data-countries="{{ job.countries_attr }}">
            <div class="job-main">
              <div class="info">
                <a href="{{ job.link }}" target="_blank" rel="noopener">{{ job.title }}</a>
                <div class="sub">
                  {% for code, label in job.country_pills %}<span class="country-pill cp-{{ code|lower }}">{{ label }}</span>{% endfor %}
                  {% if job.category %}{{ job.category }} · {% endif %}
                  {% if job.location %}{{ job.location }} · {% endif %}
                  seit {{ job.first_seen }}
                  {% if job.date_posted %} · {{ job.date_posted }}{% endif %}
                </div>
              </div>
              <span class="badge {{ job.status_class }}">{{ job.status }}</span>
            </div>
            <div class="status-buttons">
              <button data-status-value="neu">Neu</button>
              <button data-status-value="interessant">Interessant</button>
              <button data-status-value="beworben">Beworben</button>
              <button data-status-value="kein interesse">Kein Interesse</button>
              <span class="save-indicator"></span>
            </div>
          </div>
          {% endfor %}
        </div>
      </details>
      {% endfor %}
    {% else %}
      <p class="empty">Aktuell keine offenen Stellen erfasst.</p>
    {% endif %}
  </section>

  <div class="howto">
    <strong>Status ändern:</strong> Klick auf einen der Buttons unter einem Job. Ist oben ein
    GitHub-Token hinterlegt, landet der Status sofort in <code>data/state.json</code> im Repo. Jedes
    Gerät lädt beim Öffnen (und beim Zurückkehren in den Tab) diesen aktuellen Stand nach - auch ohne
    Token. PC und Handy zeigen also denselben Stand. Ohne Token bleiben Klicks auf diesem Gerät nur
    lokal (gelb markiert), bis ein Token hinterlegt ist. Dann werden sie nachgetragen, sofern auf einem
    anderen Gerät nicht zwischenzeitlich etwas Neueres gesetzt wurde. Als "Kein Interesse" markierte
    Jobs werden ausgeblendet (über "anzeigen" pro Firma wieder einblendbar). "Beworben" markierte
    Stellen stehen gesammelt unter "Meine Bewerbungen" und bleiben dort, auch wenn die Ausschreibung
    offline geht. Alternativ <code>python scripts/set_status.py &lt;job_id&gt; &lt;status&gt;</code>.
  </div>
</div>

<script>
(function () {
  "use strict";

  // Lokal gemerkte Klicks, die (noch) nicht im Repo stehen: {jobId: {status, ts, company}}.
  // Sie gelten nur, solange sie NEUER sind als der Status im Repo
  // (status_changed_at) - sonst gewinnt das Repo. Früher (Key
  // "jobwatcher_status_overrides") galt ein lokaler Klick für immer und
  // überdeckte Änderungen von anderen Geräten, daher sahen PC und Handy
  // dauerhaft unterschiedliche Stände. Die alten Einträge werden verworfen.
  var PENDING_KEY = "jobwatcher_pending_status";
  var LEGACY_KEY = "jobwatcher_status_overrides";
  var TOKEN_KEY = "jobwatcher_github_token";
  var STATUSES = ["neu", "interessant", "beworben", "kein interesse"];

  var syncBar = document.getElementById("sync-bar");
  var repo = syncBar ? syncBar.dataset.repo : "";
  var branch = syncBar ? syncBar.dataset.branch : "main";
  var syncEnabled = !!repo;

  function loadPending() {
    try {
      localStorage.removeItem(LEGACY_KEY);
      return JSON.parse(localStorage.getItem(PENDING_KEY) || "{}");
    } catch (e) { return {}; }
  }
  function savePending() {
    try { localStorage.setItem(PENDING_KEY, JSON.stringify(pending)); } catch (e) { /* privater Modus o.ä. */ }
  }
  var pending = loadPending();

  function tsValue(ts) {
    var v = ts ? Date.parse(ts) : NaN;
    return isNaN(v) ? 0 : v;
  }
  // Status, der angezeigt wird: lokaler Klick, falls neuer als der Repo-Stand
  // (data-status/data-status-ts, beim Build gerendert bzw. live nachgeladen).
  function effectiveStatus(jobEl) {
    var p = pending[jobEl.dataset.jobId];
    var serverStatus = jobEl.dataset.status || "neu";
    if (p && (p.status === serverStatus || tsValue(p.ts) <= tsValue(jobEl.dataset.statusTs))) {
      delete pending[jobEl.dataset.jobId];  // im Repo angekommen oder dort überholt
      p = null;
    }
    return p ? p.status : serverStatus;
  }

  function getToken() {
    try { return localStorage.getItem(TOKEN_KEY) || ""; } catch (e) { return ""; }
  }
  function setToken(t) {
    localStorage.setItem(TOKEN_KEY, t);
  }
  function clearToken() {
    localStorage.removeItem(TOKEN_KEY);
  }

  function slug(status) {
    return (status || "neu").trim().toLowerCase().replace(/ /g, "_");
  }
  function label(status) {
    var s = status || "neu";
    return s.charAt(0).toUpperCase() + s.slice(1);
  }

  function utf8ToB64(str) {
    return btoa(encodeURIComponent(str).replace(/%([0-9A-F]{2})/g, function (_, p1) {
      return String.fromCharCode("0x" + p1);
    }));
  }
  function b64ToUtf8(str) {
    // Die GitHub Contents API liefert Base64 mit Zeilenumbrüchen alle 60
    // Zeichen - die muss atob() erst losgeworden sein.
    var clean = str.replace(/\s/g, "");
    return decodeURIComponent(atob(clean).split("").map(function (c) {
      return "%" + ("00" + c.charCodeAt(0).toString(16)).slice(-2);
    }).join(""));
  }

  function applyStatus(jobEl, status) {
    jobEl.dataset.effectiveStatus = status;
    var badge = jobEl.querySelector(".badge");
    if (badge) {
      badge.className = "badge " + slug(status);
      badge.textContent = label(status);
    }
    var buttons = jobEl.querySelectorAll(".status-buttons button");
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].classList.toggle("active", buttons[i].dataset.statusValue === status);
    }
    var forceShow = jobEl.dataset.forceShow === "true";
    jobEl.style.display = (status === "kein interesse" && !forceShow) ? "none" : "";
  }

  function updateCompanyCounts() {
    var companies = document.querySelectorAll("details.company");
    for (var i = 0; i < companies.length; i++) {
      var companyEl = companies[i];
      var jobs = companyEl.querySelectorAll(".job[data-job-id]");
      var visible = 0, hidden = 0;
      for (var j = 0; j < jobs.length; j++) {
        if (jobs[j].style.display === "none") hidden++; else visible++;
      }
      var countEl = companyEl.querySelector(".count");
      if (countEl) countEl.textContent = "(" + visible + (hidden ? ", " + hidden + " ausgeblendet" : "") + ")";
      var toggleWrap = companyEl.querySelector(".hidden-toggle");
      var hiddenCountEl = companyEl.querySelector(".hidden-count");
      if (toggleWrap) {
        toggleWrap.style.display = hidden > 0 ? "block" : "none";
        if (hiddenCountEl) hiddenCountEl.textContent = hidden;
      }
    }
    applySearch();
  }

  // Suche/Filter: Freitext (alle Wörter müssen vorkommen, Groß-/Klein-
  // schreibung und Umlaute/Akzente egal - "zurich" findet "Zürich") über
  // Titel, Firma, Kategorie und Ort, kombiniert mit einem Status-Filter.
  // Arbeitet nur mit CSS-Klassen, damit die bestehende "Kein Interesse"-
  // Ausblendung (style.display) unangetastet bleibt.
  var searchInput, statusFilter = "alle", countryFilter = "alle";

  function norm(s) {
    return (s || "").toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/ß/g, "ss");
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }

  function highlightTitle(jobEl, terms) {
    var a = jobEl.querySelector(".info a");
    if (!a) return;
    if (a.dataset.rawTitle === undefined) a.dataset.rawTitle = a.textContent;
    var raw = a.dataset.rawTitle;
    if (!terms.length) { a.textContent = raw; return; }
    // Treffer auf dem normalisierten Text suchen (gleiche Länge wie der
    // Originaltext, solange keine Sonderfälle wie ß auftreten) und im
    // Original markieren.
    var n = raw.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
    if (n.length !== raw.length) { a.textContent = raw; return; }
    var marks = [];
    terms.forEach(function (t) {
      var idx = n.indexOf(t);
      while (idx !== -1) { marks.push([idx, idx + t.length]); idx = n.indexOf(t, idx + t.length); }
    });
    if (!marks.length) { a.textContent = raw; return; }
    marks.sort(function (x, y) { return x[0] - y[0]; });
    var html = "", pos = 0;
    marks.forEach(function (m) {
      if (m[0] < pos) return;  // überlappende Treffer überspringen
      html += escapeHtml(raw.slice(pos, m[0])) + "<mark>" + escapeHtml(raw.slice(m[0], m[1])) + "</mark>";
      pos = m[1];
    });
    a.innerHTML = html + escapeHtml(raw.slice(pos));
  }

  function applySearch() {
    if (!searchInput) return;
    var terms = norm(searchInput.value).split(/\s+/).filter(Boolean);
    var active = terms.length > 0 || statusFilter !== "alle" || countryFilter !== "alle";
    var totalMatches = 0, companyMatches = 0, countryCounts = {};
    document.body.classList.toggle("searching", active);
    var companies = document.querySelectorAll("details.company");
    for (var i = 0; i < companies.length; i++) {
      var companyEl = companies[i];
      var companyName = norm(companyEl.querySelector(".company-name").textContent);
      var jobs = companyEl.querySelectorAll(".job[data-job-id]");
      var matches = 0;
      for (var j = 0; j < jobs.length; j++) {
        var jobEl = jobs[j];
        var status = jobEl.dataset.effectiveStatus || jobEl.dataset.status || "neu";
        var hay = companyName + " " + norm(jobEl.querySelector(".info").textContent);
        var textOk = terms.every(function (t) { return hay.indexOf(t) !== -1; });
        // Ohne expliziten "Kein Interesse"-Filter bleiben ausgeblendete Jobs
        // auch in der Suche ausgeblendet (außer per "anzeigen" eingeblendet).
        var statusOk = statusFilter === "alle"
          ? (status !== "kein interesse" || jobEl.dataset.forceShow === "true")
          : status === statusFilter;
        var codes = (jobEl.dataset.countries || "unbekannt").split(" ");
        var countryOk = countryFilter === "alle" || codes.indexOf(countryFilter) !== -1;
        // Chip-Zähler: offene, nicht ausgeblendete Jobs je Land (unabhängig von den anderen Filtern)
        if (!jobEl.classList.contains("application") && status !== "kein interesse") {
          codes.forEach(function (cc) { countryCounts[cc] = (countryCounts[cc] || 0) + 1; });
        }
        var match = textOk && statusOk && countryOk;
        jobEl.classList.toggle("search-miss", active && !match);
        jobEl.classList.toggle("search-force", active && match && status === "kein interesse");
        highlightTitle(jobEl, terms);
        if (match) matches++;
      }
      var matchEl = companyEl.querySelector(".match-count");
      if (active) {
        if (companyEl.dataset.wasOpen === undefined) companyEl.dataset.wasOpen = companyEl.open ? "1" : "0";
        companyEl.classList.toggle("search-empty", matches === 0);
        if (matches > 0) companyEl.open = true;
        if (matchEl) matchEl.textContent = matches ? matches + " Treffer" : "";
        if (matches) { totalMatches += matches; companyMatches++; }
      } else {
        companyEl.classList.remove("search-empty");
        if (companyEl.dataset.wasOpen !== undefined) {
          companyEl.open = companyEl.dataset.wasOpen === "1";
          delete companyEl.dataset.wasOpen;
        }
        if (matchEl) matchEl.textContent = "";
      }
    }
    var countryBtns = document.querySelectorAll("#country-filter button[data-country]");
    for (var cb = 0; cb < countryBtns.length; cb++) {
      var cCode = countryBtns[cb].dataset.country;
      var cEl = countryBtns[cb].querySelector(".chip-count");
      if (!cEl) continue;  // "Alle"
      var cCount = countryCounts[cCode] || 0;
      cEl.textContent = "(" + cCount + ")";
      // Länder ohne (nicht ausgeblendete) Stellen: Chip weglassen, außer er ist gerade aktiv
      countryBtns[cb].style.display = (cCount === 0 && countryFilter !== cCode) ? "none" : "";
    }
    var resultEl = document.getElementById("search-result");
    if (resultEl) {
      resultEl.textContent = active
        ? (totalMatches ? totalMatches + " Treffer in " + companyMatches + (companyMatches === 1 ? " Firma" : " Firmen") : "Keine Treffer")
        : "";
    }
  }

  searchInput = document.getElementById("job-search");
  if (searchInput) {
    searchInput.addEventListener("input", applySearch);
    searchInput.addEventListener("keydown", function (ev) {
      if (ev.key === "Escape") { searchInput.value = ""; applySearch(); }
    });
    // "/" springt von überall ins Suchfeld (wie bei GitHub)
    document.addEventListener("keydown", function (ev) {
      var tag = (document.activeElement && document.activeElement.tagName) || "";
      if (ev.key === "/" && tag !== "INPUT" && tag !== "TEXTAREA") {
        ev.preventDefault();
        searchInput.focus();
      }
    });
  }
  var chips = document.querySelectorAll("#status-filter button");
  for (var c = 0; c < chips.length; c++) {
    chips[c].addEventListener("click", function (ev) {
      statusFilter = ev.currentTarget.dataset.filter;
      for (var k = 0; k < chips.length; k++) chips[k].classList.toggle("active", chips[k] === ev.currentTarget);
      applySearch();
    });
  }
  var countryChips = document.querySelectorAll("#country-filter button[data-country]");
  for (var cc = 0; cc < countryChips.length; cc++) {
    countryChips[cc].addEventListener("click", function (ev) {
      countryFilter = ev.currentTarget.dataset.country;
      for (var kc = 0; kc < countryChips.length; kc++) countryChips[kc].classList.toggle("active", countryChips[kc] === ev.currentTarget);
      applySearch();
    });
  }
  var clearSearchBtn = document.getElementById("job-search-clear");
  if (clearSearchBtn) {
    clearSearchBtn.addEventListener("click", function () {
      searchInput.value = "";
      statusFilter = "alle";
      countryFilter = "alle";
      for (var k = 0; k < chips.length; k++) chips[k].classList.toggle("active", chips[k].dataset.filter === "alle");
      for (var kc2 = 0; kc2 < countryChips.length; kc2++) countryChips[kc2].classList.toggle("active", countryChips[kc2].dataset.country === "alle");
      applySearch();
    });
  }

  function setIndicator(jobEl, state) {
    var ind = jobEl.querySelector(".save-indicator");
    if (!ind) return;
    ind.className = "save-indicator" + (state === "ok" ? " ok" : state === "err" ? " err" : state === "local" ? " local" : "");
    ind.textContent = state === "saving" ? "…" : state === "ok" ? "✓" : state === "err" ? "✗ Sync fehlgeschlagen - wird beim nächsten Öffnen erneut versucht"
      : state === "local" ? "nur auf diesem Gerät (kein Token)" : "";
    if (state === "ok") {
      setTimeout(function () { if (ind.textContent === "✓") ind.textContent = ""; }, 2000);
    }
  }

  function apiHeaders(accept) {
    var h = { "Accept": accept || "application/vnd.github+json" };
    var t = getToken();
    if (t) h["Authorization"] = "Bearer " + t;
    return h;
  }

  var stateUrl = "https://api.github.com/repos/" + repo + "/contents/data/state.json";

  // Aktuellen Inhalt von state.json holen. Das Repo ist öffentlich, Lesen
  // klappt also auch ohne Token (dann max. 60 API-Anfragen/Stunde je IP).
  // "raw" statt Base64-JSON, weil die Contents-API Dateien über 1 MB sonst
  // ohne Inhalt liefert. cache: "no-store", weil GitHub "Cache-Control:
  // max-age=60" schickt - sonst kommt bis zu einer Minute ein alter Stand.
  function fetchStateText() {
    return fetch(stateUrl + "?ref=" + encodeURIComponent(branch), {
      headers: apiHeaders("application/vnd.github.raw+json"), cache: "no-store",
    }).then(function (r) {
      if (!r.ok) throw new Error("GET " + r.status);
      return r.text();
    }).catch(function (e) {
      // Fallback ohne Token (z.B. Rate-Limit über geteilte Mobilfunk-IP):
      // raw.githubusercontent.com hat kein solches Limit, ist aber bis zu
      // ~5 Minuten gecacht.
      if (getToken()) throw e;
      return fetch("https://raw.githubusercontent.com/" + repo + "/" + encodeURIComponent(branch) + "/data/state.json", { cache: "no-store" })
        .then(function (r) {
          if (!r.ok) throw new Error("RAW " + r.status);
          return r.text();
        });
    });
  }

  function jobRecord(stateObj, company, jobId) {
    var jobs = stateObj.companies && stateObj.companies[company] && stateObj.companies[company].jobs;
    return jobs && jobs[jobId];
  }

  // Wie Pythons json.dump(sort_keys=True) - sonst wandert ein neu gesetztes
  // Feld ans Ende des Eintrags und erzeugt beim nächsten Lauf Diff-Rauschen.
  function sortKeys(o) {
    var out = {};
    Object.keys(o).sort().forEach(function (k) { out[k] = o[k]; });
    return out;
  }

  var SYNC_MAX_RETRIES = 3;
  var SYNC_RETRY_BASE_DELAY_MS = 400;

  // Alle Sync-Anfragen laufen über diese eine Promise-Kette statt parallel -
  // klickt man mehrere Jobs kurz hintereinander an, würde sonst jeder Klick
  // einen eigenen, unabhängigen GET/PUT-Zyklus starten und sich gegenseitig
  // den sha unter den Füßen wegziehen (siehe 409-Debugging). So läuft immer
  // nur ein Sync gleichzeitig - Kollisionen bleiben auf den selteneren Fall
  // eines anderen Geräts oder des täglichen Scraper-Laufs beschränkt, wofür
  // der Retry unten zuständig ist.
  var syncQueue = Promise.resolve();

  function syncStatusToGitHub(jobEl) {
    if (!syncEnabled) return;
    if (!getToken()) { setIndicator(jobEl, "local"); return; }
    syncQueue = syncQueue.then(function () {
      return syncOnce(jobEl, jobEl.dataset.company, jobEl.dataset.jobId, 0);
    });
  }

  // Repo-Stand eines Jobs ins Element übernehmen und Anzeige aktualisieren.
  function adoptServerState(jobEl, rec) {
    var before = jobEl.dataset.effectiveStatus;
    jobEl.dataset.status = rec.status || "neu";
    jobEl.dataset.statusTs = rec.status_changed_at || "";
    var now = effectiveStatus(jobEl);
    if (now !== before) {
      jobEl.dataset.forceShow = "false";
      applyStatus(jobEl, now);
      return true;
    }
    return false;
  }

  function syncOnce(jobEl, company, jobId, attempt) {
    var p = pending[jobId];
    if (!p) return Promise.resolve();  // inzwischen im Repo angekommen oder überholt
    setIndicator(jobEl, "saving");
    var sha, rec;
    return fetch(stateUrl + "?ref=" + encodeURIComponent(branch), { headers: apiHeaders(), cache: "no-store" })
      .then(function (r) {
        if (!r.ok) throw new Error("GET " + r.status);
        return r.json();
      })
      .then(function (fileData) {
        sha = fileData.sha;
        if (fileData.encoding === "base64" && fileData.content) return b64ToUtf8(fileData.content);
        // Über 1 MB: Inhalt separat holen. Er ist mindestens so neu wie der
        // sha - kam dazwischen ein Commit, scheitert der PUT mit 409 (-> Retry)
        // statt fremde Änderungen zu überschreiben.
        return fetchStateText();
      })
      .then(function (text) {
        var stateObj = JSON.parse(text);
        rec = jobRecord(stateObj, company, jobId);
        if (!rec) throw new Error("Job nicht in state.json gefunden");
        // Schon so im Repo, oder auf einem anderen Gerät später anders
        // entschieden -> nichts schreiben, der Repo-Stand gilt.
        if (rec.status === p.status || tsValue(rec.status_changed_at) >= tsValue(p.ts)) return null;
        rec.status = p.status;
        rec.status_changed_at = p.ts;
        stateObj.companies[company].jobs[jobId] = sortKeys(rec);
        return fetch(stateUrl, {
          method: "PUT",
          headers: apiHeaders(),
          body: JSON.stringify({
            message: "chore: update status via dashboard (" + company + " / " + jobId + ")",
            content: utf8ToB64(JSON.stringify(stateObj, null, 2) + "\n"),
            sha: sha,
            branch: branch,
          }),
        });
      })
      .then(function (r) {
        if (r && r.status === 409 && attempt < SYNC_MAX_RETRIES) {
          // sha war beim Schreiben schon veraltet - z.B. weil der tägliche
          // Scraper-Lauf oder ein anderes Gerät gerade geschrieben hat. Kurz
          // warten (steigender Abstand) und mit frisch gelesenem Stand erneut
          // versuchen.
          return new Promise(function (resolve) {
            setTimeout(resolve, SYNC_RETRY_BASE_DELAY_MS * (attempt + 1));
          }).then(function () {
            return syncOnce(jobEl, company, jobId, attempt + 1);
          });
        }
        if (r && !r.ok) throw new Error("PUT " + r.status);
        if (pending[jobId] === p) delete pending[jobId];
        savePending();
        if (adoptServerState(jobEl, rec)) updateCompanyCounts();
        setIndicator(jobEl, "ok");
      })
      .catch(function (e) {
        // Klick bleibt in "pending" und wird beim nächsten Laden nachgetragen.
        console.error("GitHub sync failed:", e);
        setIndicator(jobEl, "err");
      });
  }

  function wireJob(jobEl) {
    var id = jobEl.dataset.jobId;
    applyStatus(jobEl, effectiveStatus(jobEl));
    if (pending[id] && syncEnabled && !getToken()) setIndicator(jobEl, "local");

    var buttons = jobEl.querySelectorAll(".status-buttons button");
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].addEventListener("click", function (ev) {
        var newStatus = ev.currentTarget.dataset.statusValue;
        pending[id] = { status: newStatus, ts: new Date().toISOString(), company: jobEl.dataset.company };
        savePending();
        jobEl.dataset.forceShow = "false";
        applyStatus(jobEl, newStatus);
        updateCompanyCounts();
        syncStatusToGitHub(jobEl);
      });
    }
  }

  var allJobs = document.querySelectorAll(".job[data-job-id]");
  var domIds = {};
  for (var i = 0; i < allJobs.length; i++) {
    wireJob(allJobs[i]);
    domIds[allJobs[i].dataset.jobId] = true;
  }
  // Gemerkte Klicks zu Jobs, die es im Dashboard nicht mehr gibt, aufräumen
  Object.keys(pending).forEach(function (id) { if (!domIds[id]) delete pending[id]; });
  savePending();
  updateCompanyCounts();

  // Beim Öffnen (und beim Zurückkehren in den Tab, z.B. am Handy) den
  // aktuellen Stand aus dem Repo laden - auch ohne Token. Das HTML selbst wird
  // nur beim täglichen Lauf neu gebaut; Status-Klicks von anderen Geräten
  // stehen aber sofort in state.json und kommen so ohne Verzögerung an.
  var liveEl = document.getElementById("sync-live");
  var lastRefresh = 0, refreshing = false;
  function refreshFromRepo() {
    if (!syncEnabled || refreshing || Date.now() - lastRefresh < 15000) return;
    refreshing = true;
    lastRefresh = Date.now();
    fetchStateText()
      .then(function (text) {
        var stateObj = JSON.parse(text);
        var changed = false;
        for (var i = 0; i < allJobs.length; i++) {
          var rec = jobRecord(stateObj, allJobs[i].dataset.company, allJobs[i].dataset.jobId);
          if (rec && adoptServerState(allJobs[i], rec)) changed = true;
        }
        savePending();
        if (changed) updateCompanyCounts();
        // Lokale Klicks, die noch nicht im Repo stehen (Sync fehlgeschlagen
        // oder ohne Token gemacht), jetzt nachtragen - syncOnce prüft dabei,
        // dass kein anderes Gerät zwischenzeitlich Neueres gesetzt hat.
        var waiting = 0;
        for (var j = 0; j < allJobs.length; j++) {
          if (pending[allJobs[j].dataset.jobId]) { waiting++; syncStatusToGitHub(allJobs[j]); }
        }
        if (liveEl) {
          var t = new Date();
          liveEl.className = "sync-status " + (waiting && !getToken() ? "err" : "ok");
          liveEl.textContent = "Live-Stand geladen " + ("0" + t.getHours()).slice(-2) + ":" + ("0" + t.getMinutes()).slice(-2)
            + (waiting && !getToken() ? " · " + waiting + " Änderung(en) nur auf diesem Gerät" : "");
        }
      })
      .catch(function (e) {
        console.error("Aktuellen Stand laden fehlgeschlagen:", e);
        if (liveEl) {
          liveEl.className = "sync-status err";
          liveEl.textContent = "Live-Stand nicht ladbar - Anzeige vom letzten Lauf";
        }
      })
      .then(function () { refreshing = false; });
  }
  refreshFromRepo();
  document.addEventListener("visibilitychange", function () {
    if (document.visibilityState === "visible") refreshFromRepo();
  });

  var showButtons = document.querySelectorAll(".show-hidden-btn");
  for (var i = 0; i < showButtons.length; i++) {
    showButtons[i].addEventListener("click", function (ev) {
      var btn = ev.currentTarget;
      var companyEl = btn.closest("details.company");
      var expand = btn.dataset.expanded !== "true";
      var jobs = companyEl.querySelectorAll(".job[data-job-id]");
      for (var j = 0; j < jobs.length; j++) {
        var jobEl = jobs[j];
        if (jobEl.dataset.effectiveStatus === "kein interesse") {
          jobEl.dataset.forceShow = expand ? "true" : "false";
          jobEl.style.display = expand ? "" : "none";
        }
      }
      btn.dataset.expanded = expand ? "true" : "false";
      btn.innerHTML = expand
        ? "🙈 ausgeblendete Jobs wieder verbergen"
        : "🙈 <span class=\"hidden-count\">0</span> ausgeblendet (kein Interesse) - anzeigen";
      updateCompanyCounts();
    });
  }

  // Sync-Token-UI
  var tokenInput = document.getElementById("sync-token-input");
  var saveBtn = document.getElementById("sync-token-save");
  var clearBtn = document.getElementById("sync-token-clear");
  var statusEl = document.getElementById("sync-status");

  function refreshTokenUI() {
    var t = getToken();
    if (tokenInput) tokenInput.value = t ? "" : "";
    if (statusEl) statusEl.textContent = t ? "✓ Token hinterlegt" : "Kein Token: Du siehst den aktuellen Stand, Klicks hier bleiben aber nur auf diesem Gerät";
    if (statusEl) statusEl.className = "sync-status" + (t ? " ok" : " err");
    if (clearBtn) clearBtn.style.display = t ? "inline-block" : "none";
    if (tokenInput) tokenInput.placeholder = t ? "Token gesetzt - neuen Wert eingeben zum Ändern" : "GitHub-Token (Contents: read/write)";
  }

  if (saveBtn) {
    saveBtn.addEventListener("click", function () {
      var v = tokenInput.value.trim();
      if (v) {
        setToken(v); tokenInput.value = ""; refreshTokenUI();
        lastRefresh = 0; refreshFromRepo();  // lokal gemerkte Klicks gleich nachtragen
      }
    });
  }
  if (clearBtn) {
    clearBtn.addEventListener("click", function () {
      clearToken();
      refreshTokenUI();
    });
  }
  refreshTokenUI();
})();
</script>
</body>
</html>
